LLM_BASE_URL=https://example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60s
# 置于模型消息头部；空值省略system，多行可在双引号内使用\n。
LLM_SYSTEM_PROMPT=""
# system、历史、本轮文本和工具调用数据的整体Unicode字符上限。
LLM_MAX_PROMPT_CHARS=100000

# embedding独立于聊天模型配置；地址填写API基础路径，例如https://example.com/v1。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 填写模型实际输出的向量维度，创建Qdrant collection时使用同一维度。
EMBEDDING_DIMENSIONS=
EMBEDDING_TIMEOUT=60s

QDRANT_URL=http://127.0.0.1:6333
# 连接已有鉴权实例时填写，与服务端配置一致。
QDRANT_API_KEY=
QDRANT_COLLECTION=memories
# 按embedding模型建议选择Cosine、Dot、Euclid或Manhattan。
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT=10s
